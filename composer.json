{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sifrious/logres",
    "description": "Framework-neutral contracts and execution kernel for Logres.",
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Logres\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Logres\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
